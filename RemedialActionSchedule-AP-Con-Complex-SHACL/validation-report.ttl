    ], [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
    ], [
      sh:prefix "cim17";
      sh:namespace "http://iec.ch/TC57/CIM100#"^^xsd:anyURI
    ] .

<https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RemedialActionScheduleDependency.kind-applicability>
  a sh:PropertyShape;
  sh:severity sh:Violation;
  sh:name "C:NC:RAS:RemedialActionScheduleDependency.kind:applicability";
  sh:description "RemedialActionScheduleDependency.kind shall not be provided for RemedialActionScheduleDependency objects that are not part of a RemedialActionScheduleGroup.";
  sh:order 5;
  sh:group <https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RASgroup>;
  sh:path rdf:type;
  sh:sparql <https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RemedialActionScheduleDependency.kind-applicabilitySparql> .

<https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RemedialActionScheduleDependency.kind-applicabilitySparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this  
			WHERE {  
		
		BIND(EXISTS{$this nc:RemedialActionScheduleDependency.kind ?o1} AS ?a1).
		BIND(EXISTS{$this nc:RemedialActionScheduleDependency.RemedialActionScheduleGroup ?o2} AS ?a2).
        FILTER (?a1=true && ?a2=false ).
			}""";
  sh:message "RemedialActionScheduleDependency.kind is provided for RemedialActionScheduleDependency objects not part of a RemedialActionScheduleGroup.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

<https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RemedialActionScheduleResponse.rejectionReasonKind-required>
  a sh:PropertyShape;
  sh:severity sh:Violation;
  sh:name "C:NC:RAS:RemedialActionScheduleResponse.rejectionReasonKind:required";
  sh:description "RemedialActionScheduleResponse.rejectionReasonKind is required if RemedialActionScheduleResponse.kind equals RemedialActionScheduleResponseKind.refused.";
  sh:order 7;
  sh:group <https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RASgroup>;
  sh:path rdf:type;
  sh:sparql <https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RemedialActionScheduleResponse.rejectionReasonKind-requiredSparql> .

<https://ap-con.cim4.eu/RemedialActionSchedule-Complex/2.4#RemedialActionScheduleResponse.rejectionReasonKind-requiredSparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this  
			WHERE {  
		
		BIND(EXISTS{$this nc:RemedialActionScheduleResponse.rejectionReasonKind ?o1} AS ?hasRK).
		BIND(EXISTS{$this nc:RemedialActionScheduleResponse.kind nc:RemedialActionScheduleResponseKind.refused} AS ?hasR).
        FILTER (?hasRK=false && ?hasR=true ).
			}""";
  sh:message "RemedialActionScheduleResponse.rejectionReasonKind is missing when RemedialActionScheduleResponse.kind equals RemedialActionScheduleResponseKind.refused.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .
