@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport;
  sh:conforms false;
  rdf4j:truncated false;
  sh:result [ a sh:ValidationResult;
      sh:focusNode <urn:uuid:038ce404-30dc-4289-b9db-7076cb870b8e>;
      rsx:shapesGraph rdf4j:nil;
      sh:value "180"^^xsd:float;
      sh:resultPath <https://cim.ucaiug.io/ns#CsConverter.maxAlpha>;
      sh:sourceConstraint <http://iec.ch/TC57/ns/CIM/SteadyStateHypothesis-EU/constraints/IEC61970-301/3.0#CsConverter.maxAlpha-valueRangeTypicalSparql>;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent;
      sh:resultSeverity sh:Warning;
      sh:resultMessage "The value is greater than 18.";
      sh:sourceShape <http://iec.ch/TC57/ns/CIM/SteadyStateHypothesis-EU/constraints/IEC61970-301/3.0#CsConverter.maxAlpha-valueRangeTypical>
    ] .

<http://iec.ch/TC57/ns/CIM/SteadyStateHypothesis-EU/constraints/IEC61970-301/3.0#CsConverter.maxAlpha-valueRangeTypical>
  a sh:PropertyShape;
  sh:severity sh:Warning;
  sh:name "C:301:EQ:CsConverter.maxAlpha:valueRangeTypical";
  sh:description "The attributes minAlpha and maxAlpha define the range of firing angles for rectifier operation between which no discrete tap changer action takes place. The range is typically 10-18 degrees.";
  sh:order 19;
  sh:group <http://iec.ch/TC57/ns/CIM/SteadyStateHypothesis-EU/constraints/IEC61970-301/3.0#ValueConstraintsGroup>;
  sh:path <https://cim.ucaiug.io/ns#CsConverter.maxAlpha>;
  sh:sparql <http://iec.ch/TC57/ns/CIM/SteadyStateHypothesis-EU/constraints/IEC61970-301/3.0#CsConverter.maxAlpha-valueRangeTypicalSparql> .

<http://iec.ch/TC57/ns/CIM/SteadyStateHypothesis-EU/constraints/IEC61970-301/3.0#CsConverter.maxAlpha-valueRangeTypicalSparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this ?value
			WHERE {
        $this cim:CsConverter.operatingMode cim:CsOperatingModeKind.rectifier .
        $this $PATH ?value .
        FILTER (?value>18) .        
			}""";
  sh:message "The value is greater than 18.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

<https://cim.ucaiug.io/ns#> sh:declare [
      sh:prefix "cim";
      sh:namespace "https://cim.ucaiug.io/ns#"^^xsd:anyURI
    ], [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
    ], [
      sh:prefix "eu";
      sh:namespace "https://cim.ucaiug.io/ns/eu#"^^xsd:anyURI
    ] .
