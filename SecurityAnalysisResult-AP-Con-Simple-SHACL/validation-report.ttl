<https://common-constraints.eu/ClassCount-property> a sh:PropertyShape;
  sh:severity sh:Info;
  sh:name "ClassCount";
  sh:description "Counts instance of classes present in the data graph.";
  sh:order 1;
  sh:group <https://common-constraints.eu/ClassesCountGroup>;
  sh:path rdf:type;
  sh:sparql <https://common-constraints.eu/ClassCount-propertySparql> .

<https://common-constraints.eu/ClassCount-propertySparql> a sh:SPARQLConstraint;
  sh:select """ 
            SELECT $this ?class (COUNT(?instance) AS ?value)
            WHERE {
                    ?instance rdf:type ?class .
                   }
            GROUP BY $this ?class
             """;
  sh:message "The class {?class} appears {?value} times in the data graph.";
  sh:prefixes <https://common-constraints.eu/> .

<https://common-constraints.eu/> sh:declare [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    ] .

<https://ap-con.cim4.eu/SecurityAnalysisResult-Simple/2.5#AllowedClasses-property>
  a sh:PropertyShape;
  sh:message "This class is not part of the profile to which this dataset conforms to.";
  sh:severity sh:Info;
  sh:name "ClassNotInProfile";
  sh:description "Checks if the dataset contains classes which are not defined in the profile to which this dataset conforms to.";
  sh:order 1;
  sh:group <https://ap-con.cim4.eu/SecurityAnalysisResult-Simple/2.5#ProfileClassesGroup>;
  sh:path rdf:type;
  sh:in (<https://cim4.eu/ns/nc#ContingencyPowerFlowResult> <https://cim4.eu/ns/nc#RemedialActionApplied>
      <https://cim4.eu/ns/nc#BaseCasePowerFlowResult> <http://iec.ch/TC57/61970-552/ModelDescription/1#FullModel>
      <http://iec.ch/TC57/61970-552/DifferenceModel/1#DifferenceModel> <http://www.w3.org/ns/dcat#Dataset>) .
