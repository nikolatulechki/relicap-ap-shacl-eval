<http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#BoundaryPoint.fromEndIsoCode-valueValidity>
  a sh:PropertyShape;
  sh:message "Not valid two-character ISO code for Europe.";
  sh:severity sh:Violation;
  sh:name "C:301:EQ:BoundaryPoint.fromEndIsoCode:valueValidity";
  sh:description "The ISO code is a two-character country code as defined by ISO 3166 (http://www.iso.org/iso/country_codes).";
  sh:order 56;
  sh:group <http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#EQ301UML>;
  sh:path <https://cim.ucaiug.io/ns/eu#BoundaryPoint.fromEndIsoCode>;
  sh:minLength 2;
