@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport;
  sh:conforms false;
  rdf4j:truncated false;
  sh:result [ a sh:ValidationResult;
      sh:focusNode <urn:uuid:e468e6ca-8776-4c22-8f9b-390df610c2fd>;
      rsx:shapesGraph rdf4j:nil;
      sh:value "38.0065"^^xsd:float;
      sh:resultPath <https://cim.ucaiug.io/ns#CsConverter.gamma>;
      sh:sourceConstraint <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.gamma-valueRangeTypicalSparql>;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent;
      sh:resultSeverity sh:Warning;
      sh:resultMessage "The value is outside the range: 17-20 degrees.";
      sh:sourceShape <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.gamma-valueRangeTypical>
    ], [ a sh:ValidationResult;
      sh:focusNode <urn:uuid:038ce404-30dc-4289-b9db-7076cb870b8e>;
      rsx:shapesGraph rdf4j:nil;
      sh:value "18.5127"^^xsd:float;
      sh:resultPath <https://cim.ucaiug.io/ns#CsConverter.alpha>;
      sh:sourceConstraint <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.alpha-valueRangeTypicalSparql>;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent;
      sh:resultSeverity sh:Warning;
      sh:resultMessage "The value is outside the range: 10-18 degrees.";
      sh:sourceShape <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.alpha-valueRangeTypical>
    ] .

<http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.gamma-valueRangeTypical>
  a sh:PropertyShape;
  sh:severity sh:Warning;
  sh:name "C:301:SV:CsConverter.gamma:valueRangeTypical";
  sh:description "Typical value between 17 degrees and 20 degrees for an inverter. ";
  sh:order 6;
  sh:group <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#ValueConstraintsGroup>;
  sh:path <https://cim.ucaiug.io/ns#CsConverter.gamma>;
  sh:sparql <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.gamma-valueRangeTypicalSparql> .

<http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.gamma-valueRangeTypicalSparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this ?value
			WHERE {
        $this cim:CsConverter.operatingMode cim:CsOperatingModeKind.inverter .
        $this $PATH ?value .
        FILTER (?value<17 || ?value>20) .        
			}""";
  sh:message "The value is outside the range: 17-20 degrees.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

<https://cim.ucaiug.io/ns#> sh:declare [
      sh:prefix "cim";
      sh:namespace "https://cim.ucaiug.io/ns#"^^xsd:anyURI
    ], [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
    ], [
      sh:prefix "eu";
      sh:namespace "https://cim.ucaiug.io/ns/eu#"^^xsd:anyURI
    ] .

<http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.alpha-valueRangeTypical>
  a sh:PropertyShape;
  sh:severity sh:Warning;
  sh:name "C:301:SV:CsConverter.alpha:valueRangeTypical";
  sh:description "Typical value between 10 degrees and 18 degrees for a rectifier. ";
  sh:order 4;
  sh:group <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#ValueConstraintsGroup>;
  sh:path <https://cim.ucaiug.io/ns#CsConverter.alpha>;
  sh:sparql <http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.alpha-valueRangeTypicalSparql> .

<http://iec.ch/TC57/ns/CIM/StateVariables-EU/constraints/IEC61970-301/3.0#CsConverter.alpha-valueRangeTypicalSparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this ?value
			WHERE {
        $this cim:CsConverter.operatingMode cim:CsOperatingModeKind.rectifier .
        $this $PATH ?value .
        FILTER (?value<10 || ?value>18) .        
			}""";
  sh:message "The value is outside the range: 10-18 degrees.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .
