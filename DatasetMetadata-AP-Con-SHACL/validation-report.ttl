<https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#description.langTag-presence> a
    sh:PropertyShape;
  sh:severity sh:Violation;
  sh:name "description.langTag-presence";
  sh:description "This constraint validates the presence of language tag with value en for the property (attribute).";
  sh:order 1;
  sh:group <https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#LanguageTagGroup>;
  sh:path <http://purl.org/dc/terms/description>;
  sh:sparql <https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#description.langTag-presenceSparql> .

<https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#description.langTag-presenceSparql>
  a sh:SPARQLConstraint;
  sh:select """
	      SELECT $this ?value 
        WHERE {
		$this $PATH ?value .

        FILTER (lang(?value)!=\"en\" ).
        }""";
  sh:message "Language tag is not declared or it is not en.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .
